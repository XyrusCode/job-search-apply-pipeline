# Copy this file to .env and fill it in. .env is git-ignored — never commit real secrets.

# --- Gmail (for email-based applications) ---
# The sender address.
GMAIL_ADDRESS=

# Option A (recommended): use an OAuth Gmail connector/MCP authorized in an interactive session.
#   Leave GMAIL_APP_PASSWORD blank and configure the connector instead.
#
# Option B: SMTP with a Google App Password (requires 2FA enabled on the account, then create an
#   app password at https://myaccount.google.com/apppasswords). Paste the 16-char password here.
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Runtime toggles (optional; config/preferences.json is the primary control) ---
# Force dry-run regardless of preferences.json (belt-and-suspenders). Leave blank to defer to config.
# DRY_RUN=true

# --- Telegram (optional source; see sources.example.json) ---
# api_id and api_hash from https://my.telegram.org/apps (one-time, free).
TG_API_ID=
TG_API_HASH=
# The session string is written to your local MCP/helper config by --login; no need to keep it here.
